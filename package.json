  "description": "Sovereign, decentralized event photo album platform built on Nostr and Blossom",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler pages dev ./dist",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "version:sync": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add src/lib/version.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.2.1",
    "@astrojs/react": "^4.2.0",
    "@radix-ui/react-dialog": "^1.1.6",
