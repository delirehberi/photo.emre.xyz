# ==============================================================================
# photo.emre.xyz (Phoem) Environment Configuration Example
# Copy this file to .env or .env.local to configure your self-hosted deployment.
# ==============================================================================

# Public Administrator Public Key (Hex format - 64 lowercase characters)
# Users authenticating with this key bypass Lightning payment gates and access /admin
PUBLIC_ADMIN_PUBKEY=46f3c7bb33cc3019049b76dc89dbb96e34c247bdda68b6ad8632682793ff8a1a

# Blossom Media Server Endpoint
# Used for storing and retrieving high-resolution binary photo blobs (BUD-01 / BUD-04 / BUD-11)
BLOSSOM_SERVER_URL=https://media.emre.xyz

# Default Nostr Relay Mesh
# Comma-separated list of Nostr relay WebSocket endpoints for reading and publishing events
PUBLIC_DEFAULT_RELAYS=wss://relay.emre.xyz,wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol

# Canonical Site URL (used for SEO canonical URLs, sitemaps, and social share cards)
PUBLIC_SITE_URL=https://photo.emre.xyz
