---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Button from '@/components/ui/Button.astro';
import {
  getLocaleFromUrl,
  getDictionary,
  getLocalizedPath,
} from '@/lib/i18n/context';
import {
  Building2,
  Calendar,
  UploadCloud,
  Users,
  ArrowRight,
  ShieldCheck,
  Lock,
  Sparkles,
  Check,
  X,
  KeyRound,
  HardDrive,
} from 'lucide-react';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const t = getDictionary(locale);
const eventsHref = getLocalizedPath('/events', locale);
const createEventHref = getLocalizedPath('/events/create', locale);
const adminHref = getLocalizedPath('/admin', locale);
---

<BaseLayout
  title={locale === 'en'
    ? 'About Phoem — Sovereign & Open-Source Event Albums'
    : 'Phoem Hakkında — Egemen ve Açık Kaynaklı Etkinlik Albümleri'}
  description={locale === 'en'
    ? 'Open-source, sovereign event photography album platform for communities and organizations. Powered by Nostr and Blossom.'
    : 'Topluluklar ve organizasyonlar için açık kaynaklı, bağımsız etkinlik fotoğraf albümü platformu. Nostr ve Blossom destekli.'}
  lang={locale}
>
  <Header slot="header" />

  <main class="container mx-auto px-4 sm:px-6 py-12 sm:py-20 max-w-5xl">
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-5">
      <h1
        class="text-4xl sm:text-6xl font-extrabold text-zinc-950 tracking-tight leading-[1.1] text-balance"
      >
        {
          locale === 'en' ? (
            <>
              Free &amp; Sovereign Event{' '}
              <>
                <br />
                <span class="text-amber-600">
                  Photo Galleries for Communities
                </span>
              </>
            </>
          ) : (
            <>
              Topluluklar İçin{' '}
              <>
                <br />
                <span class="text-amber-600">
                  Özgür ve Bağımsız Fotoğraf Galerileri
                </span>
              </>
            </>
          )
        }
      </h1>

      <p
        class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl mx-auto"
      >
        {t.about.whatIsDesc}
      </p>

      <div class="pt-2 flex flex-wrap justify-center items-center gap-3.5">
        <Button
          variant="default"
          size="lg"
          href={eventsHref}
          className="h-11 px-6 font-semibold bg-zinc-900 hover:bg-zinc-800 text-white gap-2 shadow-xs inline-flex items-center"
        >
          <span>{t.home.exploreEvents}</span>
          <ArrowRight className="h-4 w-4 shrink-0" />
        </Button>
        <Button
          variant="outline"
          size="lg"
          href={createEventHref}
          className="h-11 px-6 font-medium border-zinc-300 text-zinc-800 hover:bg-zinc-100 inline-flex items-center"
        >
          <span>{t.nav.createEvent}</span>
        </Button>
      </div>
    </div>

    <!-- Core App Workflow (4 Steps) -->
    <div class="mt-20 sm:mt-28 space-y-10">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight">
          {locale === 'en' ? 'How Does It Work?' : 'Nasıl Çalışır?'}
        </h2>
        <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
          {
            locale === 'en'
              ? 'Set up your organization identity in four clear steps, publish your event album, and build a shared memory with your attendees.'
              : 'Dört açık adımda organizasyon kimliğinizi kurun, etkinlik albümünüzü yayınlayın ve katılımcılarınızla ortak bir hafıza inşa edin.'
          }
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        <!-- Step 1 -->
        <div
          class="rounded-2xl border border-zinc-200/90 bg-white p-7 shadow-xs hover:shadow-md hover:border-zinc-300 transition-all flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-zinc-900 text-amber-400 shadow-xs"
            >
              <Building2 className="h-5 w-5" />
            </div>
            <div>
              <span
                class="font-mono text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-500/20 px-2 py-0.5 rounded"
              >
                {locale === 'en' ? 'STEP 01 // IDENTITY' : 'ADIM 01 // KİMLİK'}
              </span>
              <h3 class="text-xl font-bold text-zinc-900 mt-2 tracking-tight">
                {t.about.step1Title.replace(/^[0-9.]+\s*/, '')}
              </h3>
              <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
                {t.about.step1Desc}
              </p>
            </div>
          </div>
          <div
            class="mt-6 pt-4 border-t border-zinc-100 font-mono text-xs text-zinc-500"
          >
            {locale === 'en' ? 'Standard:' : 'Standart:'}
            <strong class="text-zinc-700">NIP-01 (Kind 0)</strong>
          </div>
        </div>

        <!-- Step 2 -->
        <div
          class="rounded-2xl border border-zinc-200/90 bg-white p-7 shadow-xs hover:shadow-md hover:border-zinc-300 transition-all flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-zinc-900 text-amber-400 shadow-xs"
            >
              <Calendar className="h-5 w-5" />
            </div>
            <div>
              <span
                class="font-mono text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-500/20 px-2 py-0.5 rounded"
              >
                {locale === 'en' ? 'STEP 02 // EVENT' : 'ADIM 02 // ETKİNLİK'}
              </span>
              <h3 class="text-xl font-bold text-zinc-900 mt-2 tracking-tight">
                {t.about.step2Title.replace(/^[0-9.]+\s*/, '')}
              </h3>
              <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
                {t.about.step2Desc}
              </p>
            </div>
          </div>
          <div
            class="mt-6 pt-4 border-t border-zinc-100 font-mono text-xs text-zinc-500"
          >
            {locale === 'en' ? 'Standard:' : 'Standart:'}
            <strong class="text-zinc-700">NIP-52 (Kind 31922)</strong>
          </div>
        </div>

        <!-- Step 3 -->
        <div
          class="rounded-2xl border border-zinc-200/90 bg-white p-7 shadow-xs hover:shadow-md hover:border-zinc-300 transition-all flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-zinc-900 text-amber-400 shadow-xs"
            >
              <UploadCloud className="h-5 w-5" />
            </div>
            <div>
              <span
                class="font-mono text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-500/20 px-2 py-0.5 rounded"
              >
                {locale === 'en' ? 'STEP 03 // MEDIA' : 'ADIM 03 // MEDYA'}
              </span>
              <h3 class="text-xl font-bold text-zinc-900 mt-2 tracking-tight">
                {t.about.step3Title.replace(/^[0-9.]+\s*/, '')}
              </h3>
              <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
                {t.about.step3Desc}
              </p>
            </div>
          </div>
          <div
            class="mt-6 pt-4 border-t border-zinc-100 font-mono text-xs text-zinc-500"
          >
            {locale === 'en' ? 'Standard:' : 'Standart:'}
            <strong class="text-zinc-700"
              >NIP-98 &bull; NIP-94 (Kind 1063)</strong
            >
          </div>
        </div>

        <!-- Step 4 -->
        <div
          class="rounded-2xl border border-zinc-200/90 bg-white p-7 shadow-xs hover:shadow-md hover:border-zinc-300 transition-all flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-zinc-900 text-amber-400 shadow-xs"
            >
              <Users className="h-5 w-5" />
            </div>
            <div>
              <span
                class="font-mono text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-500/20 px-2 py-0.5 rounded"
              >
                {
                  locale === 'en'
                    ? 'STEP 04 // ATTENDEE'
                    : 'ADIM 04 // KATILIMCI'
                }
              </span>
              <h3 class="text-xl font-bold text-zinc-900 mt-2 tracking-tight">
                {t.about.step4Title.replace(/^[0-9.]+\s*/, '')}
              </h3>
              <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
                {t.about.step4Desc}
              </p>
            </div>
          </div>
          <div
            class="mt-6 pt-4 border-t border-zinc-100 font-mono text-xs text-zinc-500"
          >
            {locale === 'en' ? 'Structure:' : 'Yapı:'}
            <strong class="text-zinc-700"
              >{
                locale === 'en'
                  ? 'Official • Community Separation'
                  : 'Resmi • Topluluk Ayrışımı'
              }</strong
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Data Sovereignty Deep Dive & Modern Benefit-Driven UI Comparison -->
    <div
      class="mt-20 sm:mt-28 rounded-3xl border border-zinc-200/90 bg-gradient-to-b from-amber-50/40 via-white to-zinc-50/60 p-7 sm:p-12 shadow-sm space-y-10 text-zinc-900"
    >
      <!-- Section Header -->
      <div class="max-w-3xl space-y-4">
        <div
          class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1 rounded-full bg-amber-100/80 text-amber-900 border border-amber-300/60 shadow-2xs"
        >
          <ShieldCheck className="h-4 w-4 text-amber-700 shrink-0" />
          <span>
            {
              locale === 'en'
                ? 'DATA SOVEREIGNTY & INDEPENDENCE'
                : 'VERİ EGEMENLİĞİ VE SAHİPLİK'
            }
          </span>
        </div>
        <h2
          class="text-2xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 leading-tight"
        >
          {
            locale === 'en'
              ? 'Your Photos & Memories Truly Belong to You'
              : 'Fotoğraflarınız ve Albümleriniz Gerçekten Sizin'
          }
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 leading-relaxed max-w-2xl">
          {t.about.sovereigntyDesc}
        </p>
      </div>

      <!-- Modern Visual Comparison (The Silo Way vs The Phoem Way) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
        <!-- Traditional Silo Card -->
        <div
          class="rounded-2xl border border-zinc-200/90 bg-white p-6 sm:p-7 shadow-2xs flex flex-col justify-between space-y-6"
        >
          <div class="space-y-4">
            <div
              class="flex items-center justify-between pb-3 border-b border-zinc-100"
            >
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl bg-zinc-100 text-zinc-500"
                >
                  <Lock className="h-5 w-5 shrink-0" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-zinc-900">
                    {
                      locale === 'en'
                        ? 'Traditional Closed Platforms'
                        : 'Geleneksel Kapalı Platformlar'
                    }
                  </h3>
                  <p class="text-xs text-zinc-500">
                    {
                      locale === 'en'
                        ? 'Proprietary clouds & social networks'
                        : 'Kapalı bulutlar ve sosyal ağlar'
                    }
                  </p>
                </div>
              </div>
              <span
                class="text-[10px] font-mono font-medium px-2 py-0.5 rounded bg-zinc-100 text-zinc-600"
              >
                {locale === 'en' ? 'Vendor Lock-in' : 'Kilitli Silo'}
              </span>
            </div>

            <ul class="space-y-3.5 text-xs text-zinc-600">
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-600 font-bold"
                >
                  <X className="h-3.5 w-3.5" />
                </span>
                <div>
                  <strong class="font-semibold text-zinc-900 block">
                    {
                      locale === 'en'
                        ? 'Corporate Ownership'
                        : 'Şirket Mülkiyeti'
                    }
                  </strong>
                  <span>
                    {
                      locale === 'en'
                        ? 'Your photos are held hostage on private servers. Terms of service and fees change unilaterally.'
                        : 'Fotoğraflarınız şirketin kapalı veritabanında rehin tutulur. Kullanım şartları her an değişebilir.'
                    }
                  </span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-600 font-bold"
                >
                  <X className="h-3.5 w-3.5" />
                </span>
                <div>
                  <strong class="font-semibold text-zinc-900 block">
                    {
                      locale === 'en'
                        ? 'Shutdown & Deletion Risk'
                        : 'Kapanma ve Silinme Riski'
                    }
                  </strong>
                  <span>
                    {
                      locale === 'en'
                        ? 'If the company discontinues the service or suspends your account, all photos and albums are permanently lost.'
                        : 'Şirket platformu kapattığında veya hesabınız askıya alındığında tüm fotoğraf arşiviniz yok olur.'
                    }
                  </span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-600 font-bold"
                >
                  <X className="h-3.5 w-3.5" />
                </span>
                <div>
                  <strong class="font-semibold text-zinc-900 block">
                    {
                      locale === 'en'
                        ? 'Zero Interoperability'
                        : 'Dışa Aktarma Zorluğu'
                    }
                  </strong>
                  <span>
                    {
                      locale === 'en'
                        ? 'Moving your attendees and collections to another provider requires manual, lossy migration.'
                        : 'Albümleri ve katılımcı katkılarını başka bir yere taşımak neredeyse imkansızdır.'
                    }
                  </span>
                </div>
              </li>
            </ul>
          </div>

          <div
            class="pt-4 border-t border-zinc-100 text-[11px] font-mono text-zinc-400"
          >
            {
              locale === 'en'
                ? 'Result: Fragile & Dependent'
                : 'Sonuç: Bağımlı ve Kırılgan'
            }
          </div>
        </div>

        <!-- Phoem Sovereign Open Protocol Card -->
        <div
          class="rounded-2xl border-2 border-amber-400/80 bg-gradient-to-b from-amber-50/40 via-white to-white p-6 sm:p-7 shadow-sm flex flex-col justify-between space-y-6 relative overflow-hidden"
        >
          <div class="space-y-4">
            <div
              class="flex items-center justify-between pb-3 border-b border-amber-100"
            >
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500 text-zinc-950 shadow-xs"
                >
                  <Sparkles className="h-5 w-5 shrink-0" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-zinc-950">
                    {
                      locale === 'en'
                        ? 'Phoem & Open Protocol'
                        : 'Phoem & Açık Protokol'
                    }
                  </h3>
                  <p class="text-xs text-amber-900/80 font-medium">
                    {
                      locale === 'en'
                        ? 'Nostr relays & Blossom media storage'
                        : 'Nostr röle ağı ve Blossom medya'
                    }
                  </p>
                </div>
              </div>
              <span
                class="text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300"
              >
                {locale === 'en' ? '100% Sovereign' : '%100 Bağımsız'}
              </span>
            </div>

            <ul class="space-y-3.5 text-xs text-zinc-700">
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 font-bold"
                >
                  <Check className="h-3.5 w-3.5" />
                </span>
                <div>
                  <strong class="font-semibold text-zinc-950 block">
                    {
                      locale === 'en'
                        ? 'Cryptographic Key Ownership'
                        : 'Kriptografik Anahtar Sahipliği'
                    }
                  </strong>
                  <span>
                    {
                      locale === 'en'
                        ? 'Your albums are signed by your own keypair. You retain cryptographic proof of ownership.'
                        : 'Albümleriniz kendi imzanızla mühürlenir. Hiçbir aracı içeriklerinizi gasp edemez.'
                    }
                  </span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 font-bold"
                >
                  <Check className="h-3.5 w-3.5" />
                </span>
                <div>
                  <strong class="font-semibold text-zinc-950 block">
                    {
                      locale === 'en'
                        ? 'Permanent & Censorship-Resistant'
                        : 'Kalıcı ve Sansürlenemez'
                    }
                  </strong>
                  <span>
                    {
                      locale === 'en'
                        ? 'Even if the Phoem website shuts down, all albums remain preserved and discoverable across independent relays.'
                        : 'Phoem arayüzü kapansa dahi Nostr anahtarlarınızla tüm albüm ve fotoğraflar bağımsız kalır.'
                    }
                  </span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 font-bold"
                >
                  <Check className="h-3.5 w-3.5" />
                </span>
                <div>
                  <strong class="font-semibold text-zinc-950 block">
                    {
                      locale === 'en'
                        ? 'Universal Portability'
                        : 'Evrensel Taşınabilirlik'
                    }
                  </strong>
                  <span>
                    {
                      locale === 'en'
                        ? 'Read and display your galleries with any Nostr client or custom domain without vendor lock-in.'
                        : 'Verilerinizi dilediğiniz zaman bağımsız istemciler veya kendi özel alan adınızla kullanabilirsiniz.'
                    }
                  </span>
                </div>
              </li>
            </ul>
          </div>

          <div
            class="pt-4 border-t border-amber-100 text-[11px] font-mono font-semibold text-amber-800 flex items-center justify-between"
          >
            <span
              >{
                locale === 'en'
                  ? 'Architecture: NIP-01 • NIP-52 • NIP-94'
                  : 'Mimari: NIP-01 • NIP-52 • NIP-94'
              }</span
            >
            <span class="inline-flex items-center gap-1 text-emerald-700">
              <Check className="h-3 w-3" />
              {locale === 'en' ? 'Verified Open Standard' : 'Açık Standart'}
            </span>
          </div>
        </div>
      </div>

      <!-- 3 Key Takeaway Feature Badges -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div
          class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 shadow-2xs space-y-1.5"
        >
          <div
            class="flex items-center gap-2 text-zinc-900 font-semibold text-xs"
          >
            <KeyRound className="h-4 w-4 text-amber-600 shrink-0" />
            <span
              >{
                locale === 'en' ? 'Keypair Security' : 'Şifresiz Güvenlik'
              }</span
            >
          </div>
          <p class="text-[11px] text-zinc-500 leading-normal">
            {
              locale === 'en'
                ? 'No passwords or database leaks. Secure one-click auth with Nostr signer extensions.'
                : 'Şifre sızıntısı riski yok. Modern Nostr uzantılarıyla tek tıkla şifresiz ve güvenli giriş.'
            }
          </p>
        </div>

        <div
          class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 shadow-2xs space-y-1.5"
        >
          <div
            class="flex items-center gap-2 text-zinc-900 font-semibold text-xs"
          >
            <HardDrive className="h-4 w-4 text-amber-600 shrink-0" />
            <span
              >{
                locale === 'en'
                  ? 'Original Quality & EXIF'
                  : 'Orijinal Kalite & EXIF'
              }</span
            >
          </div>
          <p class="text-[11px] text-zinc-500 leading-normal">
            {
              locale === 'en'
                ? 'Lossless SHA-256 media storage preserves full camera metadata and pristine resolution.'
                : 'Fotoğraflar sıkıştırılmaz; objektif, diyafram ve ISO gibi tüm kamera detayları korunur.'
            }
          </p>
        </div>

        <div
          class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 shadow-2xs space-y-1.5"
        >
          <div
            class="flex items-center gap-2 text-zinc-900 font-semibold text-xs"
          >
            <Users className="h-4 w-4 text-amber-600 shrink-0" />
            <span
              >{
                locale === 'en'
                  ? 'Shared Community Memory'
                  : 'Ortak Topluluk Hafızası'
              }</span
            >
          </div>
          <p class="text-[11px] text-zinc-500 leading-normal">
            {
              locale === 'en'
                ? 'Official and attendee submissions merge seamlessly into one permanent community record.'
                : 'Resmi fotoğraflar ve katılımcı anıları aynı kalıcı albümde bağımsızca bir araya gelir.'
            }
          </p>
        </div>
      </div>

      <!-- Action Footer Inside Card -->
      <div class="pt-2 flex flex-wrap items-center gap-4">
        <Button
          variant="default"
          size="lg"
          href={adminHref}
          className="bg-zinc-900 hover:bg-zinc-800 text-white font-semibold inline-flex items-center gap-2 px-6 h-11 shadow-xs"
        >
          <span>{t.about.ctaBtn}</span>
          <ArrowRight className="h-4 w-4 shrink-0" />
        </Button>
        <Button
          variant="outline"
          size="lg"
          href={eventsHref}
          className="border-zinc-300 bg-white text-zinc-800 hover:bg-zinc-50 font-medium inline-flex items-center gap-2 px-6 h-11 shadow-xs"
        >
          <span>{t.home.exploreEvents}</span>
        </Button>
      </div>
    </div>
  </main>
</BaseLayout>
