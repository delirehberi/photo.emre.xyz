---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import { EventsGrid } from '@/components/events/EventsGrid';
import { fetchEventAlbums } from '@/lib/nostr/events-data';
import { getLocaleFromUrl, getDictionary } from '@/lib/i18n/context';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const t = getDictionary(locale);
const events = await fetchEventAlbums();

// Prevent edge cache poisoning when relay queries return empty due to latency or cold mesh
if (events.length === 0) {
  Astro.response.headers.set(
    'Cache-Control',
    'private, no-cache, no-store, must-revalidate',
  );
}
---

<BaseLayout
  title={`${t.events.title} — photo.emre.xyz`}
  description={t.events.subtitle}
  lang={locale}
>
  <Header slot="header" />

  <main class="container mx-auto px-4 sm:px-6 py-10 sm:py-16 max-w-7xl">
    <!-- Header banner -->
    <div class="mb-10 max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-amber-50 px-3 py-0.5 text-xs font-semibold text-amber-900 mb-3"
      >
        <span>Nostr Event Albums</span>
      </div>
      <h1
        class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight"
      >
        {t.events.title}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-zinc-500 leading-relaxed">
        {t.events.subtitle}
      </p>
    </div>

    <!-- Events Grid React Island -->
    <EventsGrid client:load initialEvents={events} initialLocale={locale} />
  </main>
</BaseLayout>
