---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import { fetchOrgWithEvents } from '@/lib/nostr/events-data';
import { pubkeyToNpub } from '@/lib/nostr/keys';
import { OrgProfileView } from '@/components/org/OrgProfileView';
import { getLocaleFromUrl } from '@/lib/i18n/context';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const { pubkey } = Astro.params;

if (!pubkey) {
  return Astro.redirect(getLocalizedPath('/events', locale));
}

const { org, events } = await fetchOrgWithEvents(pubkey);

let npub = '';
try {
  npub = pubkeyToNpub(pubkey);
} catch {
  npub = pubkey.slice(0, 16) + '...';
}

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: org.displayName || org.name,
  description: org.about,
  identifier: npub,
};

if (org.picture) {
  orgSchema.image = org.picture;
}
if (org.website) {
  orgSchema.url = org.website;
}
---

<BaseLayout
  title={`${org.displayName || org.name} — ${locale === 'en' ? 'Organisation Profile' : 'Organizasyon Profili'}`}
  description={org.about ||
    (locale === 'en'
      ? 'Nostr sovereign event organisation profile.'
      : 'Nostr bağımsız etkinlik organizasyonu profili.')}
  image={org.picture || '/og-image.jpg'}
  lang={locale}
  jsonLd={orgSchema}
>
  <Header slot="header" />

  <main class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-6xl">
    <OrgProfileView
      client:load
      initialOrg={org}
      initialEvents={events}
      pubkey={pubkey}
      initialLocale={locale}
    />
  </main>
</BaseLayout>
