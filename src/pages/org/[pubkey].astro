---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import {
  fetchOrgWithEvents,
  formatEventDateTime,
} from '@/lib/nostr/events-data';
import { pubkeyToNpub } from '@/lib/nostr/keys';
import { Badge } from '@/components/ui/badge';
import Button from '@/components/ui/Button.astro';
import { OrgZapButton } from '@/components/lightning';
import {
  getLocaleFromUrl,
  getDictionary,
  getLocalizedPath,
} from '@/lib/i18n/context';
import {
  Building2,
  ShieldCheck,
  Globe,
  Zap,
  Calendar,
  MapPin,
  Camera,
  ArrowRight,
  ArrowLeft,
} from 'lucide-react';
import { getThumbnailUrl } from '@/lib/media';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const t = getDictionary(locale);
const { pubkey } = Astro.params;

if (!pubkey) {
  return Astro.redirect(getLocalizedPath('/events', locale));
}

const { org, events } = await fetchOrgWithEvents(pubkey);
const eventsHref = getLocalizedPath('/events', locale);

let npub = '';
try {
  npub = pubkeyToNpub(pubkey);
} catch {
  npub = pubkey.slice(0, 16) + '...';
}

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: org.displayName || org.name,
  description: org.about,
  identifier: npub,
};

if (org.picture) {
  orgSchema.image = org.picture;
}
if (org.website) {
  orgSchema.url = org.website;
}
---

<BaseLayout
  title={`${org.displayName || org.name} — ${locale === 'en' ? 'Organisation Profile' : 'Organizasyon Profili'}`}
  description={org.about ||
    (locale === 'en'
      ? 'Nostr sovereign event organisation profile.'
      : 'Nostr bağımsız etkinlik organizasyonu profili.')}
  image={org.picture || '/og-image.jpg'}
  lang={locale}
  jsonLd={orgSchema}
>
  <Header slot="header" />

  <main class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-6xl">
    <!-- Back to Events -->
    <div class="mb-6">
      <a
        href={eventsHref}
        class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-500 hover:text-zinc-900 transition-colors"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        {t.events.backToAllEvents}
      </a>
    </div>

    <!-- Organization Hero Profile Card -->
    <div
      class="relative overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm"
    >
      <!-- Banner -->
      <div
        class="h-44 sm:h-56 w-full bg-gradient-to-r from-amber-500/20 via-orange-400/20 to-amber-600/20 relative overflow-hidden"
      >
        {
          org.banner && (
            <img
              src={org.banner}
              alt={org.displayName}
              class="h-full w-full object-cover"
            />
          )
        }
      </div>

      <!-- Profile Header details -->
      <div class="px-6 sm:px-8 pb-8 pt-0 relative">
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 -mt-16 sm:-mt-20 mb-6"
        >
          <div class="flex items-end gap-4 sm:gap-6">
            <div class="relative">
              {
                org.picture ? (
                  <img
                    src={org.picture}
                    alt={org.displayName}
                    class="h-24 w-24 sm:h-32 sm:w-32 rounded-2xl border-4 border-white object-cover shadow-md bg-white"
                  />
                ) : (
                  <div class="flex h-24 w-24 sm:h-32 sm:w-32 items-center justify-center rounded-2xl border-4 border-white bg-zinc-100 text-zinc-500 shadow-md">
                    <Building2 className="h-10 w-10 sm:h-12 sm:w-12" />
                  </div>
                )
              }
            </div>

            <div class="space-y-1 pb-1">
              <div class="flex flex-wrap items-center gap-2">
                <h1
                  class="text-xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight"
                >
                  {org.displayName || org.name}
                </h1>
                {
                  org.nip05 && (
                    <Badge variant="official" className="text-xs gap-1">
                      <ShieldCheck className="h-3.5 w-3.5 text-amber-600" />
                      <span>{org.nip05}</span>
                    </Badge>
                  )
                }
              </div>
              <p class="font-mono text-xs text-zinc-400">
                {npub.slice(0, 16)}...{npub.slice(-8)}
              </p>
            </div>
          </div>

          <!-- Send Zap Button Island -->
          <div class="pt-2 sm:pt-0 shrink-0">
            <OrgZapButton client:load org={org} locale={locale} />
          </div>
        </div>

        <!-- About Text -->
        {
          org.about && (
            <p class="text-sm text-zinc-600 max-w-3xl leading-relaxed mt-2 mb-6">
              {org.about}
            </p>
          )
        }

        <!-- Organization Links & Badges -->
        <div
          class="flex flex-wrap items-center gap-4 pt-4 border-t border-zinc-100 text-xs text-zinc-600"
        >
          {
            org.website && (
              <a
                href={org.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-zinc-700 hover:text-amber-600 font-medium transition-colors"
              >
                <Globe className="h-3.5 w-3.5 text-zinc-400" />
                {org.website.replace(/^https?:\/\//, '')}
              </a>
            )
          }

          {
            (org.lud16 || org.lud06) && (
              <span class="inline-flex items-center gap-1.5 text-zinc-700 font-medium">
                <Zap className="h-3.5 w-3.5 text-amber-500" />
                Lightning:{' '}
                <code
                  class="font-mono text-[11px] text-zinc-600 bg-zinc-100 px-1.5 py-0.5 rounded truncate max-w-[200px] sm:max-w-xs"
                  title={org.lud16 || org.lud06}
                >
                  {org.lud16 || org.lud06}
                </code>
              </span>
            )
          }

          <span class="inline-flex items-center gap-1.5 text-zinc-500">
            <Calendar className="h-3.5 w-3.5 text-zinc-400" />
            {events.length}
            {
              t.events.photosCount === 'fotoğraf'
                ? 'Etkinlik Albümü'
                : 'Event Albums'
            }
          </span>
        </div>
      </div>
    </div>

    <!-- Hosted Event Albums Section -->
    <div class="mt-12 space-y-6">
      <div
        class="flex items-center justify-between border-b border-zinc-200 pb-4"
      >
        <div>
          <h2 class="text-xl font-bold text-zinc-900 tracking-tight">
            {t.org.hostedEvents}
          </h2>
          <p class="text-xs text-zinc-500 mt-1">
            {
              locale === 'en'
                ? 'All event photo albums published by this organisation on the Nostr network.'
                : 'Bu organizasyon tarafından Nostr üzerinde yayınlanan tüm fotoğraf albümleri.'
            }
          </p>
        </div>
      </div>

      {
        events.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {events.map((event) => {
              const albumHref = getLocalizedPath(
                `/album/${event.dTag}`,
                locale,
              );
              const startDate = event.startDate
                ? formatEventDateTime(event.startDate, locale, event.endDate)
                : null;

              return (
                <div class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-xs transition hover:shadow-md">
                  <a
                    href={albumHref}
                    class="relative aspect-16/10 w-full overflow-hidden bg-zinc-100 block"
                  >
                    {event.coverImage ? (
                      <img
                        src={getThumbnailUrl(event.coverImage)}
                        alt={event.title}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-zinc-400">
                        <Camera className="h-8 w-8" />
                      </div>
                    )}
                  </a>

                  <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                    <div class="space-y-1.5">
                      <h3 class="font-bold text-zinc-900 group-hover:text-amber-600 transition-colors">
                        <a href={albumHref}>{event.title}</a>
                      </h3>
                      <p class="text-xs text-zinc-500 line-clamp-2">
                        {event.summary}
                      </p>
                    </div>

                    <div class="pt-3 border-t border-zinc-100 flex items-center justify-between text-xs text-zinc-500">
                      <div class="flex flex-col gap-0.5">
                        {startDate && <span>{startDate}</span>}
                        {event.location && (
                          <span class="flex items-center gap-1">
                            <MapPin className="h-3 w-3" />
                            {event.location}
                          </span>
                        )}
                      </div>

                      <Button
                        variant="outline"
                        size="sm"
                        href={albumHref}
                        className="h-7 text-xs gap-1 border-zinc-200 inline-flex items-center"
                      >
                        <span>{t.events.viewAlbum}</span>
                        <ArrowRight className="h-3 w-3 shrink-0" />
                      </Button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="p-12 text-center rounded-2xl border border-dashed border-zinc-200 bg-white text-zinc-500 text-sm">
            {t.org.noEventsYet}
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
