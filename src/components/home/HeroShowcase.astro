---
import Button from '@/components/ui/Button.astro';
import { ArrowRight, Camera, ShieldCheck } from 'lucide-react';
import {
  getLocaleFromUrl,
  getDictionary,
  getLocalizedPath,
} from '@/lib/i18n/context';

const locale = getLocaleFromUrl(Astro.url);
const t = getDictionary(locale);
const eventsHref = getLocalizedPath('/events', locale);
const createEventHref = getLocalizedPath('/events/create', locale);
---

<section
  class="relative overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24 bg-white border-b border-zinc-200"
>
  <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
    <!-- Top Hero Content -->
    <div class="text-center max-w-3xl mx-auto">
      <!-- Direct Headline without kicker/eyebrow (Impeccable craft principle) -->
      <h1
        class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-zinc-950 leading-[1.08] text-balance"
      >
        {t.home.heroTitle}
        <br />
        <span class="text-amber-600">{t.home.heroTitleHighlight}</span>
      </h1>

      <p
        class="mt-6 text-base sm:text-xl text-zinc-600 max-w-2xl mx-auto leading-relaxed"
      >
        {t.home.heroDescription}
      </p>

      <!-- Primary Actions -->
      <div class="mt-9 flex flex-wrap justify-center items-center gap-3.5">
        <Button
          variant="default"
          size="lg"
          href={eventsHref}
          className="h-11 px-6 gap-2 shadow-sm font-semibold text-sm bg-zinc-900 hover:bg-zinc-800 text-white inline-flex items-center"
        >
          <span>{t.home.exploreEvents}</span>
          <ArrowRight className="h-4 w-4 shrink-0" />
        </Button>
        <Button
          variant="outline"
          size="lg"
          href={createEventHref}
          className="h-11 px-6 font-medium border-zinc-300 text-zinc-800 hover:bg-zinc-100 hover:text-zinc-900 text-sm inline-flex items-center"
        >
          <span>{t.home.createEventCta}</span>
        </Button>
      </div>
    </div>

    <!-- Photographic Exhibition Preview Showcase -->
    <div class="mt-14 sm:mt-20 max-w-5xl mx-auto">
      <div
        class="relative rounded-2xl border border-zinc-800 bg-zinc-950 p-3 sm:p-5 shadow-2xl text-zinc-100 overflow-hidden"
      >
        <!-- Darkroom Header Strip -->
        <div
          class="flex items-center justify-between pb-3 sm:pb-4 border-b border-zinc-800/80 text-[11px] sm:text-xs font-mono text-zinc-400 px-1"
        >
          <div class="flex items-center gap-2">
            <span
              class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse"
            ></span>
            <span class="font-semibold text-zinc-200">
              {locale === 'en' ? 'LIVE GALLERY PROOF' : 'CANLI GALERİ PROVA'}
            </span>
            <span class="text-zinc-600 hidden sm:inline">&bull;</span>
            <span class="hidden sm:inline text-zinc-400"
              >NIP-94 FILE METADATA</span
            >
          </div>

          <div class="flex items-center gap-3 text-zinc-500">
            <span class="hidden sm:inline">media.emre.xyz</span>
            <span
              class="bg-zinc-800/90 text-amber-400 px-2 py-0.5 rounded text-[10px] font-mono font-semibold"
            >
              {locale === 'en' ? 'SHA-256 VERIFIED' : 'SHA-256 DOĞRULANDI'}
            </span>
          </div>
        </div>

        <!-- Visual Filmstrip / Gallery Simulation -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 sm:pt-4">
          <!-- Frame 1 -->
          <div
            class="group relative rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800 aspect-4/3 flex flex-col justify-end p-4"
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105 opacity-80"
              style="background-image: url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=800&q=80');"
            >
            </div>
            <div
              class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/40 to-transparent"
            >
            </div>

            <div class="relative z-10 space-y-1">
              <div
                class="flex items-center gap-1.5 text-[10px] font-mono text-amber-400"
              >
                <Camera className="h-3 w-3" />
                <span>24mm &bull; f/1.8 &bull; 1/250s &bull; ISO 640</span>
              </div>
              <h4 class="text-xs font-bold text-white tracking-tight">
                İstanbul Bitcoin Meetup #4
              </h4>
              <p class="text-[10px] text-zinc-400 font-mono">
                148 fotoğraf &bull; 12 katılımcı katkısı
              </p>
            </div>
          </div>

          <!-- Frame 2 -->
          <div
            class="group relative rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800 aspect-4/3 flex flex-col justify-end p-4"
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105 opacity-80"
              style="background-image: url('https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=800&q=80');"
            >
            </div>
            <div
              class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/40 to-transparent"
            >
            </div>

            <div class="relative z-10 space-y-1">
              <div
                class="flex items-center gap-1.5 text-[10px] font-mono text-amber-400"
              >
                <Camera className="h-3 w-3" />
                <span>50mm &bull; f/1.4 &bull; 1/500s &bull; ISO 320</span>
              </div>
              <h4 class="text-xs font-bold text-white tracking-tight">
                Açık Kaynak Hackathonu 2026
              </h4>
              <p class="text-[10px] text-zinc-400 font-mono">
                312 fotoğraf &bull; 24 katılımcı katkısı
              </p>
            </div>
          </div>

          <!-- Frame 3 -->
          <div
            class="group relative rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800 aspect-4/3 flex flex-col justify-end p-4"
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105 opacity-80"
              style="background-image: url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=800&q=80');"
            >
            </div>
            <div
              class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/40 to-transparent"
            >
            </div>

            <div class="relative z-10 space-y-1">
              <div
                class="flex items-center gap-1.5 text-[10px] font-mono text-amber-400"
              >
                <Camera className="h-3 w-3" />
                <span>35mm &bull; f/2.0 &bull; 1/160s &bull; ISO 800</span>
              </div>
              <h4 class="text-xs font-bold text-white tracking-tight">
                Nostr Geliştiricileri Zirvesi
              </h4>
              <p class="text-[10px] text-zinc-400 font-mono">
                86 fotoğraf &bull; 9 katılımcı katkısı
              </p>
            </div>
          </div>
        </div>

        <!-- Darkroom Footer Metrics -->
        <div
          class="mt-3 sm:mt-4 pt-3 border-t border-zinc-800/80 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-zinc-400 px-1"
        >
          <div class="flex items-center gap-2">
            <ShieldCheck className="h-3.5 w-3.5 text-amber-400" />
            <span>
              {
                locale === 'en'
                  ? 'Cryptographic Signed Contributions (Schnorr • NIP-01)'
                  : 'Kriptografik İmzalı Katkılar (Schnorr • NIP-01)'
              }
            </span>
          </div>
          <div class="text-zinc-500">
            {
              locale === 'en'
                ? 'Zero Cloud Lock-in • Uncompressed Resolution'
                : 'Sıfır Bulut Bağımlılığı • Sınırsız Çözünürlük'
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
