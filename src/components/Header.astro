---
import { Camera } from 'lucide-react';
import { HeaderAuthIsland } from './auth/HeaderAuthIsland';
import {
  getLocaleFromUrl,
  getDictionary,
  getLocalizedPath,
} from '@/lib/i18n/context';

const pathname = Astro.url.pathname;
const locale = getLocaleFromUrl(Astro.url);
const t = getDictionary(locale);
const homeHref = getLocalizedPath('/', locale);

const navLinks = [
  {
    href: homeHref,
    label: t.nav.home,
    match: (p: string) => p === '/' || p === '/en' || p === '/en/',
  },
  {
    href: getLocalizedPath('/events', locale),
    label: t.nav.events,
    match: (p: string) =>
      p.startsWith('/events') ||
      p.startsWith('/album') ||
      p.startsWith('/en/events') ||
      p.startsWith('/en/album'),
  },
  {
    href: getLocalizedPath('/about', locale),
    label: t.nav.about,
    match: (p: string) => p.startsWith('/about') || p.startsWith('/en/about'),
  },
  {
    href: getLocalizedPath('/contact', locale),
    label: t.nav.contact,
    match: (p: string) =>
      p.startsWith('/contact') || p.startsWith('/en/contact'),
  },
];

const navItems = navLinks.map((item) => ({
  href: item.href,
  label: item.label,
  isActive: item.match(pathname),
}));
---

<header
  class="sticky top-0 z-40 w-full border-b border-zinc-200 bg-white/90 backdrop-blur-md"
>
  <div
    class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6"
  >
    <div class="flex items-center gap-6 sm:gap-8">
      <a
        href={homeHref}
        class="flex items-center gap-2.5 font-bold tracking-tight text-zinc-900 transition-colors hover:text-amber-600 group"
      >
        <div
          class="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-900 text-amber-400 shadow-xs group-hover:bg-amber-600 group-hover:text-white transition-colors"
        >
          <Camera className="h-4 w-4" />
        </div>
        <span class="text-lg font-extrabold tracking-tight">
          Phoem<span class="text-amber-500 group-hover:text-amber-600">.</span>
        </span>
      </a>

      <nav
        class="hidden md:flex items-center gap-1 text-sm font-medium text-zinc-600"
      >
        {
          navLinks.map((item) => {
            const isActive = item.match(pathname);
            return (
              <a
                href={item.href}
                class={`px-3 py-1.5 rounded-md transition-colors ${
                  isActive
                    ? 'bg-zinc-100 text-zinc-900 font-semibold'
                    : 'hover:bg-zinc-50 hover:text-zinc-900'
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>

    <!-- Right Controls: Desktop auth/lang & Mobile Hamburger Menu -->
    <div class="flex items-center gap-3">
      <HeaderAuthIsland
        client:load
        initialLocale={locale}
        currentPath={pathname}
        navItems={navItems}
      />
    </div>
  </div>
</header>
